{
  "name": "yt-ripper",
  "productName": "YT-Ripper",
  "version": "1.1.0",
  "description": "YT-RIPPER | YouTube Video Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.ytripper.app",
    "icon": "YT-RIPPER.png",
    "win": {
      "target": "nsis",
      "executableName": "YT-Ripper"
    },
    "nsis": {
      "installerIcon": "YT-RIPPER.ico",
      "uninstallerIcon": "YT-RIPPER.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "yt-dlp.exe",
        "to": "yt-dlp.exe"
      },
      {
        "from": "ffmpeg",
        "to": "ffmpeg"
      }
    ]
  },
  "keywords": [],
  "author": "chibsaabji",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
